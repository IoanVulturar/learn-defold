name: "main"
instances {
  id: "plank"
  prototype: "/main/go/plank.go"
}
scale_along_z: 0
embedded_instances {
  id: "camera"
  data: "embedded_components {\n"
  "  id: \"camera\"\n"
  "  type: \"camera\"\n"
  "  data: \"aspect_ratio: 1.0\\n"
  "fov: 0.7854\\n"
  "near_z: 0.0\\n"
  "far_z: 100.0\\n"
  "orthographic_projection: 1\\n"
  "orthographic_zoom: 0.5\\n"
  "orthographic_mode: ORTHO_MODE_AUTO_FIT\\n"
  "\"\n"
  "}\n"
  ""
  position {
    z: 10.0
  }
}
