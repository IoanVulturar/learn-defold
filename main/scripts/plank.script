go.property("distance", 100)   -- how far to move along local X
go.property("duration", 0.3)   -- animation time in seconds

function init(self)
	self.origin = go.get_position()
	self.moved = false
end

function on_message(self, message_id, message, sender)
	if message_id == hash("toggle_move") then
		self.moved = not self.moved

		-- local X axis, converted to the space `position` uses
		local local_x = vmath.rotate(go.get_rotation(), vmath.vector3(1, 0, 0))

		local target = self.origin
		if self.moved then
			target = self.origin + local_x * self.distance
		end

		go.cancel_animations(".", "position")
		go.animate(".", "position", go.PLAYBACK_ONCE_FORWARD,
		target, go.EASING_OUTQUAD, self.duration)
	end
end


